# Copy this file to `.dev.vars` for local development with `wrangler dev`.
# `.dev.vars` is gitignored — never commit real values.
#
# In production these are set as Cloudflare secrets instead:
#   wrangler secret put DISCORD_BOT_TOKEN
#   wrangler secret put DISCORD_GUILD_ID
#   wrangler secret put ACCESS_TEAM_DOMAIN
#   wrangler secret put ACCESS_AUD

# Discord bot token (Developer Portal > your app > Bot > Reset Token).
DISCORD_BOT_TOKEN="your-discord-bot-token"

# Default D&D Discord server (guild) ID.
DISCORD_GUILD_ID="your-discord-server-id"

# Cloudflare Access team domain (no trailing slash).
ACCESS_TEAM_DOMAIN="https://myjacobsnetwork.cloudflareaccess.com"

# Access application AUD tag (created in Step 4 — leave blank until then).
ACCESS_AUD=""

# Local-only: skip Cloudflare Access JWT verification so you can test tools with
# `wrangler dev` (there is no Access proxy in front of a local dev server).
# NEVER set this to "true" in production.
DEV_AUTH_BYPASS="true"
