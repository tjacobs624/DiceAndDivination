# Copy this file to `.dev.vars` for local development with `wrangler dev`.
# `.dev.vars` is gitignored — never commit real values.
# In production these are set as Cloudflare secrets (Workers & Pages > the Worker
# > Settings > Variables and Secrets, or `wrangler secret put <NAME>`).

# From the Access for SaaS application (Zero Trust > Access > Applications):
ACCESS_CLIENT_ID="from the SaaS app: Client ID"
ACCESS_CLIENT_SECRET="from the SaaS app: Client secret"
ACCESS_AUTHORIZATION_URL="from the SaaS app: Authorization endpoint"
ACCESS_TOKEN_URL="from the SaaS app: Token endpoint"
ACCESS_JWKS_URL="from the SaaS app: Key endpoint"

# Random 32-byte hex. Generate with: openssl rand -hex 32
COOKIE_ENCRYPTION_KEY="generate-with-openssl-rand-hex-32"

# Discord.
DISCORD_BOT_TOKEN="your-discord-bot-token"
DISCORD_GUILD_ID="1472702824109314058"

# Optional: comma-separated emails allowed to use the tools. If unset, any user
# who passes the Access policy may use them.
# ALLOWED_EMAILS="timothyjacobs624@yahoo.com"
