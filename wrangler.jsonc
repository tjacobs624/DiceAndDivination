{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dnd-discord-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // The MCP endpoint must sit behind Cloudflare Access, and Access can only
  // protect a hostname that lives inside a Cloudflare zone in THIS account.
  // A *.workers.dev URL cannot be protected by Access, so we disable it and
  // serve the Worker from a custom domain instead.
  "workers_dev": false,

  // 1. Replace the pattern below with a subdomain on a domain you own in this
  //    Cloudflare account (the zone must be active in Cloudflare DNS).
  // 2. Then create an Access application for this exact hostname (see README).
  "routes": [
    {
      "pattern": "dnd-mcp.CHANGE-ME.example.com",
      "custom_domain": true
    }
  ],

  "observability": { "enabled": true },

  // Non-secret configuration. Secrets (DISCORD_BOT_TOKEN) are set separately
  // with `wrangler secret put` — never commit them here.
  "vars": {
    // Your Cloudflare Access team domain (no trailing slash).
    "ACCESS_TEAM_DOMAIN": "https://myjacobsnetwork.cloudflareaccess.com",

    // The Application Audience (AUD) tag of the Access application that
    // protects this Worker. Fill in after you create the Access app (README).
    "ACCESS_AUD": "CHANGE-ME-access-application-aud-tag",

    // Your D&D Discord server (guild) ID. Used as the default guild for tools.
    "DISCORD_GUILD_ID": "CHANGE-ME-discord-guild-id",

    // Set to "true" ONLY for local `wrangler dev` to skip Access JWT checks.
    // MUST be "false" (or unset) in production.
    "DEV_AUTH_BYPASS": "false"
  }
}
